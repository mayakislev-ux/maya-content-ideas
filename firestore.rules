rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'mayakislev@gmail.com';
    }
    function isAllowed() {
      return isAdmin() || (request.auth != null && exists(/databases/$(database)/documents/allowlist/$(request.auth.token.email)));
    }

    match /ideas/{ideaId} {
      allow read, update, delete: if isAllowed() && request.auth.uid == resource.data.ownerUid;
      allow create: if isAllowed() && request.auth.uid == request.resource.data.ownerUid;
    }
    match /profiles/{uid} {
      allow read, write: if isAllowed() && request.auth.uid == uid;
    }
    match /allowlist/{email} {
      allow read: if request.auth != null && request.auth.token.email == email;
      allow write: if false;
    }
    match /feedback/{feedbackId} {
      allow create: if isAllowed();
      allow read, update, delete: if false;
    }
    match /warmingPlans/{planId} {
      allow read, update, delete: if isAllowed() && request.auth.uid == resource.data.ownerUid;
      allow create: if isAllowed() && request.auth.uid == request.resource.data.ownerUid;
    }
    // 30/09/2026: טבלת החימום. מסמך אחד לכל לקוחה, לפי ה-uid שלה, ולכן
    // אין צורך ב-ownerUid בתוך המסמך כמו באוספים שהמזהה שלהם אקראי.
    match /storyTables/{uid} {
      allow read, write: if isAllowed() && request.auth.uid == uid;
      // 30/09/2026 (מאיה: "אבל למה לא מפורט?"): היא הסתכלה על החשבון שלה,
      // שהקובץ שלו ריק, וחשבה שהמסך שבור. מאיה קוראת כל טבלה כדי לראות מה
      // לקוחה רואה. קריאה בלבד, בלי כתיבה.
      allow read: if isAdmin();
    }
    match /contentPlans/{planId} {
      allow read, update, delete: if isAllowed() && request.auth.uid == resource.data.ownerUid;
      allow create: if isAllowed() && request.auth.uid == request.resource.data.ownerUid;
    }
    match /pushSubscriptions/{uid} {
      allow read, write: if isAllowed() && request.auth.uid == uid;
    }
    match /inspirationBank/{videoId} {
      allow read: if isAllowed();
      allow write: if isAdmin();
    }
  }
}
