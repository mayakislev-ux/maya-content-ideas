rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'mayakislev@gmail.com';
    }
    function isAllowed() {
      return isAdmin() || (request.auth != null && exists(/databases/$(database)/documents/allowlist/$(request.auth.token.email)));
    }
    /* 08/10/2026: מנוי "רפרנסים בלבד", 79 ש"ח לחודש. הלקוחה רשומה
       ב-allowlist כמו כולן, אבל עם plan:'refs', ולכן isAllowed() לבדו
       כבר לא מספיק כדי לגשת לתוכן. isFull() הוא מה שמגן על כל השאר.

       11/10/2026: כאן ישב `.data.plan`, כלומר קריאה לשדה שלא קיים אצל
       אף לקוחה ותיקה. plan נכתב רק ללקוחות המנוי החדש, ומיגרציה שתוסיף
       אותו לכל השאר לא נכתבה מעולם. שדה חסר בכללי Firestore הוא שגיאת
       הערכה, ושגיאה היא חסימה, ולכן מ-08/10 כל הלקוחות הוותיקות איבדו
       גישה לרעיונות, לתוכניות החימום ולטבלת הסטורי. מבחוץ זה נראה
       כאילו התוכניות שלהן נמחקו, והן דיווחו בדיוק כך.

       data.get עם ברירת מחדל הוא מה שהופך את זה לבטוח: מי שאין לה
       plan היא לקוחה מלאה, כמו שהיה לפני המנוי החדש, ו-'refs' נשאר
       חסום בדיוק כמו קודם. */
    function planOf() {
      return get(/databases/$(database)/documents/allowlist/$(request.auth.token.email)).data.get('plan', 'full');
    }
    function isFull() {
      return isAdmin() || (isAllowed() && planOf() != 'refs');
    }
    /* 15/10/2026: מנוי חודשי נגמר לפי paidUntil (מתעדכן מהתשלומים במורנינג).
       המסך כבר מוציא מנוית שפג תוקפה, אבל קריאה ישירה למסד עדיין עברה.
       data.get עם ברירת מחדל, כי לרוב הלקוחות אין paidUntil בכלל (ראו 11/10). */
    function notExpired() {
      return isAdmin() || get(/databases/$(database)/documents/allowlist/$(request.auth.token.email)).data.get('paidUntil', null) == null
        || get(/databases/$(database)/documents/allowlist/$(request.auth.token.email)).data.paidUntil > request.time;
    }

    match /ideas/{ideaId} {
      allow read, update, delete: if isFull() && request.auth.uid == resource.data.ownerUid;
      allow create: if isFull() && request.auth.uid == request.resource.data.ownerUid;
    }
    match /profiles/{uid} {
      allow read, write: if isAllowed() && request.auth.uid == uid;
    }
    match /allowlist/{email} {
      allow read: if request.auth != null && request.auth.token.email == email;
      allow write: if false;
    }
    match /feedback/{feedbackId} {
      allow create: if isAllowed();
      allow read, update, delete: if false;
    }
    match /warmingPlans/{planId} {
      allow read, update, delete: if isFull() && request.auth.uid == resource.data.ownerUid;
      allow create: if isFull() && request.auth.uid == request.resource.data.ownerUid;
    }
    // 30/09/2026: טבלת החימום. מסמך אחד לכל לקוחה, לפי ה-uid שלה, ולכן
    // אין צורך ב-ownerUid בתוך המסמך כמו באוספים שהמזהה שלהם אקראי.
    match /storyTables/{uid} {
      allow read, write: if isFull() && request.auth.uid == uid;
      // 30/09/2026 (מאיה: "אבל למה לא מפורט?"): היא הסתכלה על החשבון שלה,
      // שהקובץ שלו ריק, וחשבה שהמסך שבור. מאיה קוראת כל טבלה כדי לראות מה
      // לקוחה רואה. קריאה בלבד, בלי כתיבה.
      allow read: if isAdmin();
    }
    // 13/10/2026: "העוזר שלך ליצירת סרטון" - מסמך אחד לכל לקוחה (הסשן
    // הפעיל שלה, לא היסטוריה), אותה צורה בדיוק כמו storyTables.
    match /videoAssistantSessions/{uid} {
      /* 20/10/2026: גם מנוי הרפרנסים, כל עוד המנוי בתוקף */
      allow read, write: if (isFull() || (isAllowed() && notExpired())) && request.auth.uid == uid;
      allow read: if isAdmin();
    }
    /* 02/10/2026 (מאיה): "בגלל שהסטוריז בצבע מותג אז הייתי רוצה
       שאת הטקסט והצבעים תתאימי בול לגוונים של הצבעי מותג... ושהכל ישמר
       תמיד ולא כל פעם מחדש". הגדרות המותג והרצפים שנבנו, לכל אחת
       בנפרד. כרגע זה של מאיה בלבד, אבל הכלל כבר לפי uid כדי שלא
       יהיה צורך לשנות את המבנה כשזה ייפתח. */
    match /storySettings/{uid} {
      allow read, write: if isAdmin() && request.auth.uid == uid;
    }
    match /storySequences/{seqId} {
      allow read, update, delete: if isAdmin() && request.auth.uid == resource.data.ownerUid;
      allow create: if isAdmin() && request.auth.uid == request.resource.data.ownerUid;
    }
    match /contentPlans/{planId} {
      allow read, update, delete: if isFull() && request.auth.uid == resource.data.ownerUid;
      allow create: if isFull() && request.auth.uid == request.resource.data.ownerUid;
    }
    match /pushSubscriptions/{uid} {
      allow read, write: if isAllowed() && request.auth.uid == uid;
    }
    match /inspirationBank/{videoId} {
      allow read: if isAllowed() && notExpired();
      allow write: if isAdmin();
    }
  }
}
