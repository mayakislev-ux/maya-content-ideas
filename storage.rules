rules_version = '2';

// 02/10/2026 (מאיה): "צריך בחלק של הסטורי כרגע רק לי תיקייה שאני יכולה
// בעצם להעלות תמונות לרקעים של סטוריז".
//
// כרגע זה שלה בלבד. לא "מוסתר בממשק" אלא חסום בשרת: גם מי שתנחש את הכתובת
// של קובץ לא תקבל אותו, וגם מי שתנסה להעלות תיחסם. כשזה ייפתח ללקוחות,
// התנאי של המייל יוחלף והנתיב לפי uid כבר מוכן לזה.

service firebase.storage {
  match /b/{bucket}/o {

    function isMaya() {
      return request.auth != null
        && request.auth.token.email == 'mayakislev@gmail.com'
        && request.auth.token.email_verified == true;
    }

    match /storyAssets/{uid}/{file} {
      allow read: if isMaya() && request.auth.uid == uid;

      // 10MB ותמונות בלבד. בלי התנאי הזה אפשר להעלות וידאו של חצי ג'יגה
      // בטעות ולשלם על זה.
      allow create, update: if isMaya()
        && request.auth.uid == uid
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      allow delete: if isMaya() && request.auth.uid == uid;
    }

    // 04/11/2026: "✨ תמלול מדויק" בשכפול. כל אחת מעלה סרטון רק לתיקייה
    // שלה, הפונקציה transcribeReference קוראת אותו ומוחקת. אין קריאה מהדפדפן
    // בכלל. מה שנשאר (העלאה שלא נשלחה לתמלול) נמחק אחרי יום בכלל של ה-bucket
    // (lifecycle על transcribeUploads/). ההרשאה למנוי נבדקת בפונקציה.
    //
    // 05/11/2026: עד היום כל חשבון גוגל מאומת יכול היה להעלות לכאן עד 200MB
    // בכל פעם, גם בלי שום מנוי. עכשיו רק מי שרשומה ב-allowlist ובמנוי בתוקף,
    // באותה בדיקה בדיוק כמו isAllowed() ו-notExpired() ב-firestore.rules
    // (כאן דרך firestore.exists/get, כללים בין-שירותיים). מנוי רפרנסים כן
    // מורשה, כמו בפונקציה (allowRefs).
    function allowlistDoc() {
      return /databases/(default)/documents/allowlist/$(request.auth.token.email);
    }
    function canTranscribe() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && (isMaya()
          || (firestore.exists(allowlistDoc())
            && (firestore.get(allowlistDoc()).data.get('paidUntil', null) == null
              || firestore.get(allowlistDoc()).data.paidUntil > request.time)));
    }

    match /transcribeUploads/{uid}/{file} {
      allow create: if canTranscribe()
        && request.auth.uid == uid
        && request.resource.size < 200 * 1024 * 1024
        && request.resource.contentType.matches('video/.*');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // כל השאר סגור
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
